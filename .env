# OpenAI-compatible API key
OPENAI_API_KEY=your-api-key-here

# Base URL — change for local models or proxies (e.g. http://localhost:11434/v1)
OPENAI_BASE_URL=http://127.0.0.1:22227/v1

# Model used for translation
TRANSLATE_MODEL=gemma-4-26b-a4b-it

# Target language for Ctrl+T translation
TRANSLATE_LANG=Russian
